# ---------------------------------------------------------------------------
# Required in production. Set these in the Hostinger Node.js app's
# Environment Variables, never in the repo.
# ---------------------------------------------------------------------------

# Mailbox password for info@scripteeze.in (Hostinger Emails -> that account).
# Without it the contact form still saves every enquiry; the notification
# emails simply stay queued on disk until the password is set.
SMTP_PASS=

# Protects GET /api/contact/export. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_EXPORT_TOKEN=replace-with-at-least-24-random-characters

# ---------------------------------------------------------------------------
# Optional overrides. The Hostinger values below are already the defaults, so
# none of these need to be set.
# ---------------------------------------------------------------------------

# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@scripteeze.in
# MAIL_FROM=info@scripteeze.in
# MAIL_TO=scripteeze15@gmail.com

# Where submissions.csv is written. In production this already defaults to
# /home/u376055756/scripteeze-submissions, which survives deployments.
#
# Only override with an ABSOLUTE path outside the application folder. A relative
# value such as ./server resolves inside Hostinger's disposable hbuilds tree and
# is wiped on every deploy, so the app rejects it rather than losing enquiries.
# CONTACT_DATA_DIR=/home/u376055756/scripteeze-submissions
