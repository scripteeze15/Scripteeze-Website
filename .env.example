# Generate a long random value and add it in Hostinger's Environment Variables.
CONTACT_EXPORT_TOKEN=replace-with-at-least-24-random-characters

# Optional. In production the app already defaults to
# /home/u376055756/scripteeze-submissions, which survives deployments.
#
# Only set this to override that, and only ever to an ABSOLUTE path outside the
# application folder. A relative path such as ./server lands inside Hostinger's
# disposable hbuilds tree and is wiped on every deploy — the app now refuses to
# start writing there rather than losing enquiries silently.
# CONTACT_DATA_DIR=/home/u376055756/scripteeze-submissions
